    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>
var date_key = order_date_key;
var ship_key = ship_code;

var profit_margin_pct = (sales != 0) ? (profit / sales) : 0;


var ship_delay_days = null;
if (order_date != null &amp;&amp; ship_date != null) {
    var diffTime = Math.abs(ship_date.getTime() - order_date.getTime());
    ship_delay_days = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
}


var is_loss = (profit &lt; 0);
var high_discount = (discount > 0.5);
</jsScript_script>
      </jsScript>
    </jsScripts>
